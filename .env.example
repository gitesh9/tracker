# Remote Postgres (Neon) used for accounts and for syncing when the device is online.
# Leave unset to run Ascend entirely locally with no sign-in.
DATABASE_URL="postgres://user:password@ep-example.neon.tech/ascend?sslmode=require"

# Google sign-in (optional). Create an OAuth client in Google Cloud and add
# <your-app-url>/api/public/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional AI features (server-side only)
GEMINI_API_KEY=""
# Background reminders (optional). Generate with: node scripts/generate-push-keys.mjs
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
# Protects /api/public/push/dispatch — your scheduler sends it as a Bearer token.
CRON_SECRET=""
